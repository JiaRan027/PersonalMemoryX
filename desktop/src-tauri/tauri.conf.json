{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PersonalMemory",
  "version": "0.2.10",
  "identifier": "io.personalmemory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../COPYRIGHT": "COPYRIGHT",
      "../../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "binaries/personalmemory-service/": "personalmemory-service/",
      "binaries/personalmemory-mcp/": "personalmemory-mcp/",
      "binaries/personalmemory-hook/": "personalmemory-hook/"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRUE2RENBRDkyRENDRDQKUldUVXpDM1p5bTNxYzcwcHdBWjdlQzJoalh4R29NZkhzUEVYYUdYSitWd3NIMWNaSWZDUFVtUGkK",
      "endpoints": [],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
